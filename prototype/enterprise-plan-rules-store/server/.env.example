PORT=4000
HOST=127.0.0.1

# MongoDB Configuration (optional - use if NOT using DynamoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/enterprise-plan-rules-store

# DynamoDB Configuration (set USE_DYNAMODB=true to enable)
USE_DYNAMODB=false
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_PLANS_TABLE=BMAD-CRTC-PLANS
DYNAMODB_RULES_TABLE=BMAD-CRTC-RULES

